# העתק ל-.env ומלא. הקובץ .env נמצא ב-.gitignore ולא נכנס לגיט.
# הדרך הנוחה ליצור אותו היא דרך setup.html.

# ---- מודל שפה — רק זה שבחרת ב-config.yaml ----
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---- טלגרם ----
# בוט אחד משרת את כל הנושאים.
TELEGRAM_BOT_TOKEN=

# Chat ID נפרד לכל נושא. השם חייב להתאים ל-chat_id_env שב-config.yaml.
TELEGRAM_CHAT_ID_ECONOMY=
# TELEGRAM_CHAT_ID_SECURITY=
# TELEGRAM_CHAT_ID_SPORTS=

# ברירת מחדל לנושא שלא הוגדר לו chat_id_env
# TELEGRAM_CHAT_ID=

# ---- אימייל (רק אם הפעלת יעד email) ----
# SMTP_USER=
# SMTP_PASS=

# ---- פרוקסי לתמלולי יוטיוב — נחוץ רק בהרצה בענן ----
# יוטיוב חוסם כתובות של מרכזי נתונים, ולכן תמלולים נכשלים ב-GitHub Actions.
# חייב פרוקסי residential; datacenter לא יעזור.
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=
# או כל ספק אחר:
# HTTP_PROXY_URL=http://user:pass@host:port
